// Audited reference implementation, reconstructed from KPI definitions.
// These formulas are not an export of the compressed PBIX model.
// Add each measure individually in Power BI against the existing car_data table.
Total Sales = SUM(car_data[Price ($)])
Cars Sold = COUNTROWS(car_data)
Average Price = DIVIDE([Total Sales], [Cars Sold])
YTD Total Sales = TOTALYTD([Total Sales], 'Calendar Table'[Date])
YTD Cars Sold = TOTALYTD([Cars Sold], 'Calendar Table'[Date])
YTD Average Price = DIVIDE([YTD Total Sales], [YTD Cars Sold])
MTD Total Sales KPI = TOTALMTD([Total Sales], 'Calendar Table'[Date])
MTD Cars Sold KPI = TOTALMTD([Cars Sold], 'Calendar Table'[Date])
MTD Average Price KPI = DIVIDE([MTD Total Sales KPI], [MTD Cars Sold KPI])
Previous YTD Sales = CALCULATE([YTD Total Sales], SAMEPERIODLASTYEAR('Calendar Table'[Date]))
Previous YTD Cars Sold = CALCULATE([YTD Cars Sold], SAMEPERIODLASTYEAR('Calendar Table'[Date]))
Previous YTD Average Price = DIVIDE([Previous YTD Sales], [Previous YTD Cars Sold])
Sales Difference = [YTD Total Sales] - [Previous YTD Sales]
Cars Sold Difference = [YTD Cars Sold] - [Previous YTD Cars Sold]
Average Price Difference = [YTD Average Price] - [Previous YTD Average Price]
YOY Sales Growth = DIVIDE([Sales Difference], [Previous YTD Sales])
YOY Cars Sold = DIVIDE([Cars Sold Difference], [Previous YTD Cars Sold])
YOY Average Price Difference = DIVIDE([Average Price Difference], [Previous YTD Average Price])
Sales Difference Color = IF([Sales Difference] >= 0, "#228B22", "#B22222")
Average Price Difference Color = IF([Average Price Difference] >= 0, "#228B22", "#B22222")
